# ==========================================
# KTransport Production Configuration
# ==========================================

# Port Mappings
API_PORT=8080
WEB_PORT=80
DB_PORT=5432

# GHCR image refs pulled by `docker compose pull` on the VPS — normally left at
# their defaults (:latest); each repo's deploy.yml also pushes a :<git-sha> tag if
# you ever need to pin/rollback a specific build.
API_IMAGE=ghcr.io/nitesh-singh-1/kt_backend:latest
WEB_IMAGE=ghcr.io/nitesh-singh-1/ktfrontend:latest

# ASP.NET Environment (Production or Development)
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL Database Configuration
POSTGRES_VERSION=17.1-alpine
POSTGRES_DB=kt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongPassword123!

# JWT Token Settings (Must be at least 32 characters long)
JWT_SECRET=ReplaceWithYourSecureRandomKeyMin32CharsLong!
JWT_ISSUER=KTransportAPI
JWT_AUDIENCE=KTransportClient
JWT_EXPIRY=60

# CORS: browser origins allowed to call the API directly (the Electron desktop build
# disables webSecurity and is not affected by this). Add every web origin that needs access.
CORS_ORIGIN_0=http://129.121.132.103
CORS_ORIGIN_1=

# Email / SMTP (transactional emails: password-reset OTP, welcome).
# Leave EMAIL_ENABLED=false to run without a mail server — emails are logged, not sent,
# and (in that mode only) the password-reset OTP is returned in the API response for testing.
# Set EMAIL_ENABLED=true in production with real SMTP credentials.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@your-domain.example
EMAIL_FROM_NAME=KTransport

# Public base URL of the web frontend — used to build invite/accept links in emails.
FRONTEND_BASE_URL=http://129.121.132.103

# Object storage (MinIO / S3) for tenant assets such as logos.
# The api reaches MinIO over the internal docker network at http://minio:9000.
# 9000 = S3 API, 9001 = MinIO admin console (both bound to localhost on the host).
MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ktminio
MINIO_ROOT_PASSWORD=ChangeThisToAStrongMinioPassword123!
MINIO_BUCKET=ktransport-assets
MINIO_REGION=us-east-1
# Internal endpoint the api uses to reach MinIO (leave as-is for the bundled service).
MINIO_INTERNAL_URL=http://minio:9000
# Public base URL of THIS API, used to build absolute logo serve URLs. Set this when a
# reverse proxy rewrites the Host header (e.g. https://api.your-domain.com). Leave empty
# to derive it from the incoming request.
API_PUBLIC_URL=
