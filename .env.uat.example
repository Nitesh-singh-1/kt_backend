# ==========================================
# KTransport UAT Configuration
# Deployed as /opt/ktransport-uat/.env — a SEPARATE file from prod's
# /opt/ktransport/.env. Every value below MUST differ from prod's .env
# (especially JWT_SECRET and POSTGRES_PASSWORD) — see docker-compose.uat.yml's
# header comment for why that isolation matters.
# ==========================================

# Port Mappings — deliberately offset from prod's (8080/80/5432) so both
# stacks can run on the same VPS without colliding.
API_PORT_UAT=8081
WEB_PORT_UAT=8082
DB_PORT_UAT=5433

ASPNETCORE_ENVIRONMENT=Production

# GHCR image refs — note the :uat tag, never :latest (that's prod's tag).
# deploy-uat.yml (triggered by pushes to `develop`) publishes :uat.
API_IMAGE_UAT=ghcr.io/nitesh-singh-1/kt_backend:uat
WEB_IMAGE_UAT=ghcr.io/nitesh-singh-1/ktfrontend:uat

# PostgreSQL — separate database name AND a separate Docker volume
# (kt_postgres_data_uat) from prod. Never point this at prod's DB.
POSTGRES_VERSION=17.1-alpine
POSTGRES_DB=kt_uat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToADifferentStrongPasswordThanProd!

# JWT — MUST be a different secret than prod's. A token minted by UAT must
# never be valid against prod's API and vice versa.
JWT_SECRET=ReplaceWithADifferentRandomKeyThanProdMin32Chars!
JWT_ISSUER=KTransportAPI-UAT
JWT_AUDIENCE=KTransportClient-UAT
JWT_EXPIRY=60

# CORS — UAT's own frontend origin (port 8082), not prod's.
CORS_ORIGIN_0=http://129.121.132.103:8082
CORS_ORIGIN_1=

# Email — leave disabled on UAT by default; testers don't need real OTP/
# invite emails firing. Enable + point at a sandbox SMTP if you specifically
# need to test the email flow itself.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply-uat@your-domain.example
EMAIL_FROM_NAME=KTransport UAT

FRONTEND_BASE_URL=http://129.121.132.103:8082
